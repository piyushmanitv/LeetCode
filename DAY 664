Companies
Hint
You are given an integer array nums.

Find the minimum length of a subarray that is not identical to any other subarray in nums.

Return an integer denoting the minimum possible length of such a subarray.

Two subarrays are considered identical if they have the same length and the same elements in corresponding positions.










class Solution {
    vector<int> buildSA(const vector<int>& nums) {
        int n = nums.size();

        vector<int> vals = nums;
        sort(vals.begin(), vals.end());

        vals.erase(unique(vals.begin(), vals.end()), vals.end());

        vector<int> a(n + 1);

        for (int i = 0; i < n; i++) {
            a[i] = lower_bound(vals.begin(), vals.end(), nums[i])
                   - vals.begin() + 1;
        }

        a[n] = 0;

        int N = n + 1;
        int alphabet = max(N, (int)vals.size() + 1);

        vector<int> p(N), c(N);
        vector<int> cnt(alphabet, 0);

        // Initial counting sort.
        for (int x : a)
            cnt[x]++;

        for (int i = 1; i < alphabet; i++)
            cnt[i] += cnt[i - 1];

        for (int i = N - 1; i >= 0; i--)
            p[--cnt[a[i]]] = i;

        int classes = 1;
        c[p[0]] = 0;

        for (int i = 1; i < N; i++) {
            if (a[p[i]] != a[p[i - 1]])
                classes++;

            c[p[i]] = classes - 1;
        }

        // Doubling.
        vector<int> pn(N), cn(N);

        for (int len = 1; len < N; len *= 2) {
            for (int i = 0; i < N; i++) {
                pn[i] = p[i] - len;

                if (pn[i] < 0)
                    pn[i] += N;
            }

            fill(cnt.begin(), cnt.begin() + classes, 0);

            for (int x : pn)
                cnt[c[x]]++;

            for (int i = 1; i < classes; i++)
                cnt[i] += cnt[i - 1];

            for (int i = N - 1; i >= 0; i--) {
                int x = pn[i];
                p[--cnt[c[x]]] = x;
            }

            cn[p[0]] = 0;
            int newClasses = 1;

            for (int i = 1; i < N; i++) {
                pair<int, int> cur = {
                    c[p[i]],
                    c[(p[i] + len) % N]
                };

                pair<int, int> prev = {
                    c[p[i - 1]],
                    c[(p[i - 1] + len) % N]
                };

                if (cur != prev)
                    newClasses++;

                cn[p[i]] = newClasses - 1;
            }

            c.swap(cn);
            classes = newClasses;

            if (classes == N)
                break;
        }

        p.erase(p.begin());

        return p;
    }

    vector<int> buildLCP(const vector<int>& nums,
                         const vector<int>& sa) {
        int n = nums.size();

        vector<int> rank(n), lcp(n, 0);

        for (int i = 0; i < n; i++)
            rank[sa[i]] = i;

        int h = 0;

        for (int i = 0; i < n; i++) {
            int r = rank[i];

            if (r == 0) {
                h = 0;
                continue;
            }

            int j = sa[r - 1];

            while (i + h < n && j + h < n &&
                   nums[i + h] == nums[j + h]) {
                h++;
            }

            lcp[r] = h;

            if (h > 0)
                h--;
        }

        return lcp;
    }

public:
    int smallestUniqueSubarray(vector<int>& nums) {
        int n = nums.size();

        if (n == 0)
            return 0;

        vector<int> sa = buildSA(nums);
        vector<int> lcp = buildLCP(nums, sa);

        vector<int> rank(n);

        for (int r = 0; r < n; r++)
            rank[sa[r]] = r;

        int ans = n;

        for (int i = 0; i < n; i++) {
            int r = rank[i];

            int mx = lcp[r];

            if (r + 1 < n)
                mx = max(mx, lcp[r + 1]);

            if (mx >= n - i)
                continue;

            ans = min(ans, mx + 1);
        }

        return ans;
    }
};
