KN long long kern3505(const int* a, int n, int x, int k, int* ord, int* tmp, int* rk, int* vr, u64_3505* L0, u64_3505* L1, long long* w, long long* d0, long long* d1) {
    int C[2048];
    for (int i = 0; i < 2048; ++i) C[i] = 0; for (int i = 0; i < n; ++i) ++C[(a[i] + 1000000) & 2047];
    for (int i = 0, s = 0; i < 2048; ++i) { int c = C[i]; C[i] = s; s += c; }
    for (int i = 0; i < n; ++i) tmp[C[(a[i] + 1000000) & 2047]++] = i;
    for (int i = 0; i < 2048; ++i) C[i] = 0; for (int i = 0; i < n; ++i) ++C[(a[i] + 1000000) >> 11];
    for (int i = 0, s = 0; i < 2048; ++i) { int c = C[i]; C[i] = s; s += c; }
    for (int t = 0; t < n; ++t) { int i = tmp[t]; ord[C[(a[i] + 1000000) >> 11]++] = i; }
