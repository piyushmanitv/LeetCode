KI void set3505(u64_3505* L0, u64_3505* L1, int r) { L0[r >> 6] |= 1ULL << (r & 63); L1[r >> 12] |= 1ULL << ((r >> 6) & 63); }
KI void clr3505(u64_3505* L0, u64_3505* L1, int r) { if (!(L0[r >> 6] &= ~(1ULL << (r & 63)))) L1[r >> 12] &= ~(1ULL << ((r >> 6) & 63)); }
KI int next3505(const u64_3505* L0, const u64_3505* L1, int r) { 
    int q = r + 1, w = q >> 6; u64_3505 b = L0[w] & (~0ULL << (q & 63)); if (b) return (w << 6) | __builtin_ctzll(b);
    int w1 = (w + 1) >> 6; u64_3505 c = (w + 1) & 63 ? L1[w1] & (~0ULL << ((w + 1) & 63)) : L1[w1];
    while (!c) c = L1[++w1];
    int ww = (w1 << 6) | __builtin_ctzll(c); return (ww << 6) | __builtin_ctzll(L0[ww]);
}
KI int prev3505(const u64_3505* L0, const u64_3505* L1, int r) {  
